<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Quản lý đề thi TOEIC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root { --primary: #1F4E79; --accent: #2E75B6; }
        body { background: #eef2f7; font-family: 'Segoe UI', system-ui, sans-serif; }
        .sidebar {
            width: 250px; min-height: 100vh; background: var(--primary); color: #fff;
            position: fixed; top: 0; left: 0; display: flex; flex-direction: column;
        }
        .sidebar .brand { padding: 20px 18px; font-weight: 800; font-size: 15px; line-height: 1.4; border-bottom: 1px solid rgba(255,255,255,.15); }
        .sidebar .user { padding: 14px 18px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,.15); }
        .sidebar .user .gv { font-size: 11px; opacity: .7; }
        .sidebar nav { padding: 10px 0; flex: 1; }
        .sidebar nav a {
            display: block; padding: 11px 18px; color: rgba(255,255,255,.85); text-decoration: none;
            font-size: 14px; border-left: 3px solid transparent;
        }
        .sidebar nav a:hover { background: rgba(255,255,255,.08); color: #fff; }
        .sidebar nav a.active { background: rgba(255,255,255,.15); border-left-color: #fff; color: #fff; font-weight: 600; }
        .main { margin-left: 250px; padding: 24px; }
        .stat-card { background: #fff; border-radius: 12px; padding: 18px 22px; border: 1px solid #e5e7eb; }
        .stat-card .n { font-size: 26px; font-weight: 800; color: var(--primary); }
        .stat-card .c { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: .5px; }
        .card { border-radius: 12px; border: 1px solid #e5e7eb; }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="brand">📘 HỆ THỐNG QUẢN LÝ ĐỀ THI TRỰC TUYẾN</div>
        <div class="user">
            <div>👤 GV</div>
            <div class="gv">Giảng viên: Nguyễn Văn A</div>
        </div>
        <nav>
            <a href="/Exam" class="active">📄 Quản lý đề thi</a>
            <a href="/Exam">📊 Thống kê kết quả</a>
            <a href="#">🗂 Ngân hàng câu hỏi</a>
            <a href="#">👥 Danh sách thí sinh</a>
            <a href="#">⚙ Cài đặt hệ thống</a>
        </nav>
    </aside>

    <main class="main">
        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
