@model StatisticsDto
@{
    ViewData["Title"] = "Thống kê kết quả";
    var maxWrong = Model.TopWrongQuestions.Count > 0 ? Model.TopWrongQuestions[0].WrongCount : 1;
    var maxDist = Model.ScoreDistribution.Count > 0 ? Model.ScoreDistribution.Max(b => b.Count) : 0;
    var topWrongQ = Model.TopWrongQuestions.Count > 0 ? Model.TopWrongQuestions[0] : null;
}
<h5 class="mb-1">Báo cáo thống kê: @Model.Title (ID #@Model.ExamId)</h5>
<p class="text-muted small">Dữ liệu phân tích dựa trên @Model.AttemptCount lượt nộp bài thực tế từ CSDL.</p>
<a href="/Exam" class="btn btn-outline-secondary btn-sm mb-3">← Về danh sách</a>

<!-- The thong ke -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="n">@Model.AttemptCount <small style="font-size:14px">lượt thi</small></div>
            <div class="c">Tổng lượt làm bài</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="n">@Model.AverageScore <small style="font-size:14px">/ 100 câu</small></div>
            <div class="c">Điểm trung bình của đề</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            @if (topWrongQ != null)
            {
                <div class="n">Câu @topWrongQ.QuestionNumber <small style="font-size:14px">(@topWrongQ.WrongCount lượt sai)</small></div>
            }
            else
            {
                <div class="n">—</div>
            }
            <div class="c">Câu sai nhiều nhất</div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Bang top cau sai -->
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header fw-bold">⚠️ Top câu hỏi thí sinh sai nhiều nhất</div>
            <div class="card-body p-0">
                @if (Model.TopWrongQuestions.Count == 0)
                {
                    <div class="p-3 text-muted">Chưa có dữ liệu làm bài.</div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Hạng</th><th>Câu hỏi & Phần thi</th><th>Số lượt sai</th><th>Tỷ lệ sai</th></tr>
                        </thead>
                        <tbody>
                            @{ var rank = 1; }
                            @foreach (var q in Model.TopWrongQuestions)
                            {
                                <tr>
                                    <td class="fw-bold">@rank</td>
                                    <td>
                                        <div class="fw-bold">Câu @q.QuestionNumber</div>
                                        <div class="small text-muted">Part @q.Part</div>
                                    </td>
                                    <td>@q.WrongCount / @Model.AttemptCount lượt</td>
                                    <td>@q.WrongRate%</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Bieu do phan bo diem -->
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header fw-bold">📈 Biểu đồ phân bố điểm số thí sinh</div>
            <div class="card-body">
                @if (maxDist == 0)
                {
                    <div class="text-muted">Chưa có dữ liệu điểm.</div>
                }
                else
                {
                    @foreach (var b in Model.ScoreDistribution)
                    {
                        var pct = maxDist > 0 ? (int)Math.Round(b.Count * 100.0 / maxDist) : 0;
                        <div class="d-flex align-items-center mb-2">
                            <div style="width:70px" class="small">@b.Label</div>
                            <div class="flex-grow-1 bg-light rounded" style="height:18px">
                                <div class="rounded" style="width:@pct%; height:18px; background:#2E75B6"></div>
                            </div>
                            <div style="width:40px" class="small text-end">@b.Count</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Nhan xet & de xuat -->
<div class="card">
    <div class="card-header fw-bold">📌 Nhận xét & Đề xuất hệ thống</div>
    <div class="card-body">
        <ul class="mb-0">
            <li>Phân tích xu hướng làm bài của sinh viên ở các phần thi khó (câu sai nhiều nhất thuộc Part @(topWrongQ?.Part ?? 5)).</li>
            <li>Đề xuất bổ sung bài tập củng cố cho các dạng câu hỏi có tỷ lệ sai cao.</li>
            <li>Điểm trung bình @Model.AverageScore/100 — cân nhắc điều chỉnh thời gian hoặc độ khó đề.</li>
        </ul>
    </div>
</div>
