@{
    ViewData["Title"] = "Nhập đề thi";
}
<h4>Nhập đề thi từ file .docx hoặc .pdf</h4>
<p class="text-muted">
    File phải đúng chuẩn tag (xem <code>Tags_va_CSDL_ThietKe.md</code>). Nếu sai format,
    hệ thống sẽ <strong>hủy toàn bộ, không lưu</strong> và hiển thị lỗi ngay bên dưới.
</p>

@if (ViewData["Ok"] != null)
{
    <div class="alert alert-success">@ViewData["Ok"]</div>
}
@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger" style="white-space:pre-wrap">@ViewData["Error"]</div>
}

<form method="post" action="/Exam/Import" enctype="multipart/form-data" class="card p-4 bg-white" style="max-width:520px">
    <div class="mb-3">
        <label class="form-label">Chọn file .docx hoặc .pdf</label>
        <input type="file" name="file" accept=".docx,.pdf" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Nhập đề</button>
    <a href="/Exam" class="btn btn-outline-secondary">Quay lại</a>
</form>
