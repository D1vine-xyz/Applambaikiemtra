@model List<ExamSummaryDto>
@{
    ViewData["Title"] = "Quản lý đề thi";
    var s = (DashboardStatsDto)ViewBag.Stats;
}
<h5 class="mb-3">Danh sách bộ đề thi trực tuyến</h5>

<!-- The thong ke -->
<div class="row mb-4">
    <div class="col-md-3"><div class="stat-card"><div class="n">@s.TotalExams</div><div class="c">Tổng số đề thi</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="n">@s.PublishedExams</div><div class="c">Đã xuất bản</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="n">@s.TotalQuestions</div><div class="c">Tổng số câu hỏi</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="n">@s.TotalAttempts</div><div class="c">Lượt thi đã nộp</div></div></div>
</div>

<a class="btn btn-primary mb-3" href="/Exam/Import">+ Nhập đề mới</a>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có đề thi nào. Hãy nhập đề từ file .docx.</div>
}
else
{
    <div class="card">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th><th>Tên đề thi</th><th>Thời gian</th><th>Số câu</th>
                    <th>Phần thi</th><th>Trạng thái</th><th style="width:300px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var filename = e.Title.Replace(" ", "_") + "_Tagged.docx";
                    <tr>
                        <td>@e.Id</td>
                        <td>
                            <div class="fw-bold">@e.Title</div>
                            <div class="small text-muted">File nguồn: @filename</div>
                        </td>
                        <td>@e.TimeLimitMinutes phút</td>
                        <td>@e.QuestionCount</td>
                        <td><span class="badge bg-light text-dark border">Part 5 • 6 • 7</span></td>
                        <td>
                            @if (e.IsPublished)
                            {
                                <span class="badge bg-success">Đã xuất bản</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Bản nháp</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="/Exam/Preview/@e.Id">Xem trước</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/Exam/Edit/@e.Id">Sửa</a>
                            <a class="btn btn-sm btn-outline-info" href="/Exam/Statistics/@e.Id">Thống kê</a>
                            <form method="post" action="/Exam/Publish" class="d-inline">
                                <input type="hidden" name="id" value="@e.Id" />
                                @if (e.IsPublished)
                                {
                                    <input type="hidden" name="published" value="false" />
                                    <button class="btn btn-sm btn-outline-warning">Hủy</button>
                                }
                                else
                                {
                                    <input type="hidden" name="published" value="true" />
                                    <button class="btn btn-sm btn-success">Xuất bản</button>
                                }
                            </form>
                            <form method="post" action="/Exam/Delete" class="d-inline"
                                  onsubmit="return confirm('Xoá đề thi này và toàn bộ câu hỏi, lượt thi liên quan?');">
                                <input type="hidden" name="id" value="@e.Id" />
                                <button class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
